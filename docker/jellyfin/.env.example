# Apple Silicon friendly media stack defaults
PUID=501
PGID=20
TZ=America/New_York

# Storage layout on external drive
MEDIA_ROOT=/Volumes/Seagate2T/media
CONFIG_ROOT=/Volumes/Seagate2T/media/config
DOWNLOADS_ROOT=/Volumes/Seagate2T/media/downloads
LIBRARY_ROOT=/Volumes/Seagate2T/media

# Local app ports
JELLYFIN_PORT=8096
SEERR_PORT=5055
SONARR_PORT=8989
RADARR_PORT=7878
BAZARR_PORT=6767
PROWLARR_PORT=9696
QBITTORRENT_PORT=8080

# qBittorrent listen port
QBITTORRENT_LISTEN_PORT=6881

# Allow LAN apps to access qBittorrent through Gluetun firewall
LOCAL_SUBNET=192.168.1.0/24

# Surfshark VPN (WireGuard recommended)
VPN_TYPE=wireguard
SERVER_COUNTRIES="United States"
WIREGUARD_PRIVATE_KEY=replace-with-surfshark-wireguard-private-key
WIREGUARD_ADDRESSES=10.14.0.2/16

# OpenVPN fallback (leave blank when using WireGuard)
OPENVPN_USER=
OPENVPN_PASSWORD=
